# Chaves das skills recriar-carrossel e recriar-carrossel-image-gen.
# Copie este arquivo para .env nesta mesma pasta (~/.claude/skills/recriar-carrossel/.env)
# e preencha só o que for usar. O Claude pede a chave na primeira vez que precisar.

# Baixar a referência pelo link do Instagram (opcional: sem ela, mande os prints)
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Gerar foto ou slide COM o rosto do criador (GPT Image 2)
# https://openrouter.ai/keys  (coloque crédito em https://openrouter.ai/credits)
OPENROUTER_API_KEY=

# Gerar slide SEM rosto (Gemini 3 Pro Image), modo só com imagem
# https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=
